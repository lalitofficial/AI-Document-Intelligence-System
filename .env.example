# Pipeline tuning
MAX_WORKERS=2
MAX_CONCURRENT_JOBS=3
DATABASE_URL=sqlite+aiosqlite:///./pdf_processing.db
BUCKET_STORAGE_FOLDER=./bucket_storage

# OCR — local (PaddleOCR/Tesseract, CPU-only) | donut | thirdparty (OCR.space)
OCR_PROVIDER=local
OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=
OCR_DEVICE=cpu

# Detection models
HUGGINGFACE_TOKEN=
STAMP_SERVICE_TYPE=yolo_transformer
STAMP_DEVICE=cpu

# Structured extraction LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-0528:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
